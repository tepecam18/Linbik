<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageVersion>0.0.1</PackageVersion>
		<Version>$(GitVersion_NuGetVersionV2)</Version>

		<Description>Provides seamless Linbik PASETO Authorize and Login capabilities. Uses PASETO v4.public (Ed25519) for cookie-based local authentication. Registration and login flows are executed on Linbik.com and handled securely by this package.</Description>
		<Authors>tepecam18</Authors>
		<Company>Linbik</Company>
		<PackageTags>authentication;paseto;ed25519;tepecam18;linbik;auth;login</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://linbik.com</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<IncludeSource>true</IncludeSource>

		<!-- deterministic/CI -->
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Debug bilgisi - HER ZAMAN embedded -->
		<DebugType>embedded</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<EmbedAllSources>true</EmbedAllSources>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Optimizasyonları Debug'da kapat -->
		<Optimize Condition="'$(Configuration)' == 'Debug'">false</Optimize>

		<!-- sourcelink -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/tepecam18/Linbik.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<!-- Paseto.Core is already pulled in transitively via Linbik.Core -->
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Linbik.Core\Linbik.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')" />
	</ItemGroup>
<ItemGroup><Compile Include="../AuthManager.Shared/RefreshTokens.cs" Link="Services/RefreshTokens.cs" /></ItemGroup>
</Project>
