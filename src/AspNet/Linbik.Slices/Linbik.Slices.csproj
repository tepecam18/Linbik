<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageVersion>0.0.1</PackageVersion>
		<Version>$(GitVersion_NuGetVersionV2)</Version>

		<Description>Vertical-slice infrastructure for Linbik services: ILinbikSender dispatch, Result&lt;T&gt;, validation pipeline, minimal-API endpoint helpers, plus a source generator and analyzer that turn declarative [LinbikSlice]/[LFlow] slices into endpoint mappings and DI registrations.</Description>
		<Authors>tepecam18</Authors>
		<Company>Linbik</Company>
		<PackageTags>linbik;vertical-slice;cqrs;minimal-api;source-generator;tepecam18</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://linbik.com</PackageProjectUrl>

		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

		<DebugType>embedded</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<EmbedAllSources>true</EmbedAllSources>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Optimize Condition="'$(Configuration)' == 'Debug'">false</Optimize>

		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/tepecam18/Linbik.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<!-- Minimal API + endpoint metadata + DI için ASP.NET Core shared framework. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Linbik.Core\Linbik.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--
			ProjectReference + OutputItemType=Analyzer sadece BU projenin (Linbik.Slices)
			derlemesine generator'ı bağlar; NuGet paketine gömülmez ve paketi
			PackageReference ile tüketen projelere TRANSITIVE akmaz. Generator dll'ini
			analyzers/dotnet/cs altına elle paketleyerek, PackageReference ile tüketen
			her projenin LINBIK001 analyzer'ını ve slice source generator'ını otomatik
			almasını sağlıyoruz (ekstra analyzer ProjectReference/PackageReference
			eklemeye gerek kalmaz).
		-->
		<None Include="..\Linbik.Slices.Generators\bin\$(Configuration)\netstandard2.0\Linbik.Slices.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>
