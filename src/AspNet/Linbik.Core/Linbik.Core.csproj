<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageVersion>0.0.2</PackageVersion>
		<Version>$(GitVersion_NuGetVersionV2)</Version>

		<Description>Core library providing shared dependencies and models for Linbik. Recommended for advanced manual integration; otherwise included by default in other Linbik packages.</Description>
		<Authors>tepecam18</Authors>
		<Company>Linbik</Company>
		<PackageTags>authentication;paseto;yarp;tepecam18;linbik;core</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://linbik.com</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<IncludeSource>true</IncludeSource>

		<!-- deterministic/CI -->
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Debug bilgisi - HER ZAMAN embedded -->
		<DebugType>embedded</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<EmbedAllSources>true</EmbedAllSources>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		
		<!-- Optimizasyonları Debug'da kapat -->
		<Optimize Condition="'$(Configuration)' == 'Debug'">false</Optimize>

		<!-- sourcelink için -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/tepecam18/Linbik.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Linbik.Core, Authorize attribute'ları (LinbikAuthorize / LinbikApplicationAuthorize /
			LinbikDelegatedAuthorize) host eder. Bu attribute'lar Microsoft.AspNetCore.Authorization
			tipine bağımlı olduğundan ASP.NET Core shared framework referansı gereklidir.
		-->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Aşağıdaki Microsoft.AspNetCore.* / Microsoft.Extensions.* paketleri
			Microsoft.AspNetCore.App framework reference'ı tarafından zaten sağlanır;
			ayrıca PackageReference olarak listelemek NU1510 uyarısı üretir.
			Yalnızca framework dışı paketler burada kalır.
		-->
		<PackageReference Include="Paseto.Core" Version="1.6.0" />

		<!-- Resilience (Polly) for HttpClient — framework dışı -->
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />

		<!-- OpenAPI document generation + linbik-flows extension transformer — framework dışı -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>


</Project>
