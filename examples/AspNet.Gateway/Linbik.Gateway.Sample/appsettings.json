{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ── Linbik Gateway Auth ────────────────────────────────────────────────
  // Her scheme için Ed25519 public key (Base64, 32 byte) ve audience değeri.
  // KeylessMode: true ise imza doğrulaması yapılmaz (sadece geliştirme ortamı).
  "LinbikGateway": {
    "Name": "Linbik.Gateway.Sample",
    "Auth": {
      "Self": {
        "PublicKey": "",
        "Audience": "linbik-client",
        "KeylessMode": false
      },
      "Delegated": {
        "PublicKey": "",
        "Audience": "linbik-delegated",
        "KeylessMode": false
      },
      "Apps": {
        "PublicKey": "",
        "Audience": "linbik-apps",
        "KeylessMode": false
      }
    },
    "OpenApi": {
      "Self":      { "ExposeInProduction": false },
      "Delegated": { "ExposeInProduction": true  },
      "Apps":      { "ExposeInProduction": true  }
    }
  },

  // ── YARP ReverseProxy ─────────────────────────────────────────────────
  "ReverseProxy": {
    "Routes": {

      // ── Self routes ──────────────────────────────────────────────────
      // Tüm /self/** trafiği → echo-cluster, prefix /self çıkarılır.
      "self-echo": {
        "ClusterId": "echo-cluster",
        "AuthorizationPolicy": "SelfPolicy",
        "Match": { "Path": "/self/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/self" } ],
        "Metadata": {
          "linbik:scheme": "self",
          "linbik:audiences": "self"
        }
      },

      // ── Delegated routes ─────────────────────────────────────────────
      "delegated-echo": {
        "ClusterId": "echo-cluster",
        "AuthorizationPolicy": "DelegatedPolicy",
        "Match": { "Path": "/delegated/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/delegated" } ],
        "Metadata": {
          "linbik:scheme": "delegated",
          "linbik:audiences": "delegated"
        }
      },

      // ── Apps routes ───────────────────────────────────────────────────
      "apps-echo": {
        "ClusterId": "echo-cluster",
        "AuthorizationPolicy": "AppsPolicy",
        "Match": { "Path": "/apps/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/apps" } ],
        "Metadata": {
          "linbik:scheme": "apps",
          "linbik:audiences": "apps"
        }
      },

      // ── Products routes (ikinci downstream — N:N OpenAPI gösterimi) ──
      "self-products": {
        "ClusterId": "products-cluster",
        "AuthorizationPolicy": "SelfPolicy",
        "Match": { "Path": "/self/products/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/self" } ],
        "Metadata": {
          "linbik:scheme": "self",
          "linbik:audiences": "self"
        }
      },
      "delegated-products": {
        "ClusterId": "products-cluster",
        "AuthorizationPolicy": "DelegatedPolicy",
        "Match": { "Path": "/delegated/products/{**catchall}" },
        "Transforms": [ { "PathRemovePrefix": "/delegated" } ],
        "Metadata": {
          "linbik:scheme": "delegated",
          "linbik:audiences": "delegated"
        }
      }
    },

    "Clusters": {
      "echo-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5101/" }
        },
        "Metadata": {
          "linbik:openapi-path": "/openapi/v1.json"
        }
      },
      "products-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5102/" }
        },
        "Metadata": {
          "linbik:openapi-path": "/openapi/v1.json"
        }
      }
    }
  }
}
