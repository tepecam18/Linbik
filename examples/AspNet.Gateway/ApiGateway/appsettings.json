{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "https://linbik.com",
      "http://localhost:3000",
      "http://localhost:5461"
    ]
  },

  "LinbikGateway": {
    "RefreshIntervalSeconds": 60,
    "FetchTimeoutSeconds": 5,
    "DownstreamOpenApiPath": "/openapi/v1.json",
    "EtagMaxAgeSeconds": 600,
    "Sources": [
      {
        "ServicePrefix": "linbik",
        "Address": "http://localhost:8080/",
        "DisplayName": "Linbik Gateway (Self Auth Endpoints)",
        "IsGateway": true
      },
      {
        "ServicePrefix": "arithmetic",
        "Address": "http://localhost:3102/",
        "DisplayName": "Arithmetic"
      },
      {
        "ServicePrefix": "aggregation",
        "Address": "http://localhost:3101/",
        "DisplayName": "Aggregation"
      }
    ]
  },

  "Linbik": {
    "PasetoAuth": {
      "Mode": "Local",
      "Issuer": "Linbik",
      "Audience": "linbik-gateway",
      "SharedKeyBase64": "LinbikExampleSecretKeyAtLeast32CharsLong!LinbikExampleSecretKeyAtLeast32CharsLongLinbikExampleSecretKeyAtLeast32CharsLong",
      "PkceEnabled": false
    },

    // Delegated + Application bearer şemaları için Linbik platformunun Ed25519 public key'i.
    // Self (cookie) ile farklı anahtar kullanır: Self = Local SharedKey, Delegated/Application = Public.
    "Server": {
      "PublicKey": "m9lMWYx4+Mz7AoiRT+fX2P/fW5P+rca3elWk2nIKY/c=",
      "PackageName": "apigateway.sample",
      "JwtIssuer": "Linbik"
    }
  }
}
