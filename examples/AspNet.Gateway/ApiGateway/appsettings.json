{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Linbik": {
    "LinbikUrl": "http://localhost:5461",
    "KeylessMode": true,
    "PasetoAuth": {
      "Mode": "Local",
      "Issuer": "Linbik",
      "Audience": "linbik-gateway",
      "SharedKeyBase64": "LinbikExampleSecretKeyAtLeast32CharsLong!LinbikExampleSecretKeyAtLeast32CharsLongLinbikExampleSecretKeyAtLeast32CharsLong",
      "PkceEnabled": false
    }
  },

  "ReverseProxy": {
    "Routes": {
      "apps-arithmetic": {
        "ClusterId": "arithmetic-cluster",
        "AuthorizationPolicy": "LinbikApplicationAuthorize",
        "Match": { "Path": "/apps/arithmetic/{**catch-all}" },
        "Metadata": { "Linbik-Flow": "Application" },
        "Transforms": [
          { "PathPattern": "/api/arithmetic/{**catch-all}" }
        ]
      },
      "apps-aggregation": {
        "ClusterId": "aggregation-cluster",
        "AuthorizationPolicy": "LinbikApplicationAuthorize",
        "Match": { "Path": "/apps/aggregation/{**catch-all}" },
        "Metadata": { "Linbik-Flow": "Application" },
        "Transforms": [
          { "PathPattern": "/api/aggregation/{**catch-all}" }
        ]
      },

      "delegated-arithmetic": {
        "ClusterId": "arithmetic-cluster",
        "AuthorizationPolicy": "LinbikDelegatedAuthorize",
        "Match": { "Path": "/delegated/arithmetic/{**catch-all}" },
        "Metadata": { "Linbik-Flow": "Delegated" },
        "Transforms": [
          { "PathPattern": "/api/arithmetic/{**catch-all}" }
        ]
      },
      "delegated-aggregation": {
        "ClusterId": "aggregation-cluster",
        "AuthorizationPolicy": "LinbikDelegatedAuthorize",
        "Match": { "Path": "/delegated/aggregation/{**catch-all}" },
        "Metadata": { "Linbik-Flow": "Delegated" },
        "Transforms": [
          { "PathPattern": "/api/aggregation/{**catch-all}" }
        ]
      },

      "self-arithmetic": {
        "ClusterId": "arithmetic-cluster",
        "AuthorizationPolicy": "LinbikAuthorize",
        "Match": { "Path": "/arithmetic/{**catch-all}" },
        "Metadata": { "Linbik-Flow": "Self" },
        "Transforms": [
          { "PathPattern": "/api/arithmetic/{**catch-all}" }
        ]
      },
      "self-aggregation": {
        "ClusterId": "aggregation-cluster",
        "AuthorizationPolicy": "LinbikAuthorize",
        "Match": { "Path": "/aggregation/{**catch-all}" },
        "Metadata": { "Linbik-Flow": "Self" },
        "Transforms": [
          { "PathPattern": "/api/aggregation/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "arithmetic-cluster": {
        "Destinations": {
          "arithmetic": { "Address": "http://localhost:5181/" }
        }
      },
      "aggregation-cluster": {
        "Destinations": {
          "aggregation": { "Address": "http://localhost:5247/" }
        }
      }
    }
  }
}
