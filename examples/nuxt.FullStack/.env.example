# Build-time setting: true = SSR; false = CSR with Nitro backend.
NUXT_SSR=true
NUXT_PUBLIC_LINBIK_WEB_ORIGIN=https://localhost:3000

# Server-only credentials. Register callback at the public origin:
# https://localhost:3000/api/Linbik/callback
NUXT_LINBIK_API_BASE_URL=https://api.linbik.com
NUXT_LINBIK_API_KEY=
NUXT_LINBIK_SERVICE_ID=
NUXT_LINBIK_CLIENT_ID=
# Generate a k4.local key with: pnpm --dir ../../src/Web/Linbik.PasetoAuthManager.Server keygen
NUXT_LINBIK_SESSION_KEY=
# Comma-separated additional authorization-page origins, if different from the API origin.
NUXT_LINBIK_AUTHORIZATION_ORIGINS=
# Optional development HTTP only on localhost/127.0.0.1; never for deployed environments.
NUXT_LINBIK_ALLOW_INSECURE_HTTP=false
