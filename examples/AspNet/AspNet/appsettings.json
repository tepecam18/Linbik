{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.AspNetCore.Authentication": "Trace",
      "Microsoft.AspNetCore.Authorization": "Trace"
    }
  },
  "AllowedHosts": "*",
  "Linbik": {
    //"LinbikUrl": "http://localhost:5461"
    "Clients": [
      {
        // this client is intentionally left blank to allow default clients to be applied
      },
      {
        "Name": "Mobile",
        "ClientId": "d5e9b0b4-b972-432c-8aa2-6744ae9262a7",
        "ActionResultType": "Json"
      }
    ],
    "Server": {
      "PublicKey": "change_your_public_key",
      "PackageName": "service-test"
    }
  },
  "Linbik2": {
    "LinbikUrl": "http://localhost:5461",
    "Name": "Web App",
    "ServiceId": "3132bb27-6c14-446a-89c6-75bf3931513a",
    "Clients": [
      {
        "ClientId": "928b9d2c-d701-438a-abc1-44aa5257e5d9",
        "BaseUrl": "https://localhost:7020",
        "ClientType": "Web"
      }
    ],
    "ApiKey": "lnbk_TIVZLFjN9AX6DNTuUfnCJSM4AUTaITTD",

    "PasetoAuth": {
      "SharedKeyBase64": "LinbikExampleSecretKeyAtLeast32CharsLong!LinbikExampleSecretKeyAtLeast32CharsLongLinbikExampleSecretKeyAtLeast32CharsLong",
      "Issuer": "Linbik",
      "Audience": "linbik-example-client",
      "PkceEnabled": false,
      "AutoUpdateRedirectUri": true
    },

    "Server": {
      "PublicKey": "change_your_public_key",
      "PackageName": "service-test"
    },

    "Resilience": {
      "Enabled": true,
      "MaxRetryAttempts": 3,
      "RetryDelayMs": 1000,
      "MaxRetryDelayMs": 30000,
      "CircuitBreakerEnabled": true,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerSamplingDurationSeconds": 30,
      "CircuitBreakerDurationSeconds": 30,
      "TimeoutSeconds": 30,
      "AttemptTimeoutSeconds": 10
    },

    "RateLimit": {
      "Enabled": true,
      "PolicyName": "LinbikAuth",
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "UseSlidingWindow": false,
      "SegmentsPerWindow": 4
    },

    "Audit": {
      "Enabled": true,
      "LogSuccessfulOperations": true,
      "LogFailedOperations": true,
      "IncludeUserAgent": true,
      "IncludeIpAddress": true,
      "MaskSensitiveData": true
    },

    "EnableHeartbeat": true,
    "HeartbeatIntervalSeconds": 60,

    "YARP": {
      "IntegrationServices": {
        "payment-gateway": {
          "SourcePath": "/api/payment",
          "TargetBaseUrl": "https://payment.example.com",
          "TargetPath": "/api/v1/pay"
        },
        "survey-service": {
          "SourcePath": "/api/survey",
          "TargetBaseUrl": "https://survey.example.com",
          "TargetPath": "/api/v2/integration"
        },
        "service-test": {
          "SourcePath": "/api/serverTest",
          "TargetBaseUrl": "https://localhost:7020",
          "TargetPath": "/api/integration"
        }
      }
    }
  }
