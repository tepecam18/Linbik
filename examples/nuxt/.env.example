# Build-time rendering mode: true (SSR) or false (CSR with Nitro server).
NUXT_SSR=true
# Private upstream; never exposed to the browser.
NUXT_LINBIK_BACKEND_BASE_URL=http://localhost:5096
NUXT_LINBIK_PROTECTED_PATH=/Test/Protected
# Public HTTPS origin served by Caddy (Nuxt itself listens on 3001).
NUXT_PUBLIC_LINBIK_WEB_ORIGIN=https://localhost:3000
NUXT_PUBLIC_LINBIK_CLIENT_NAME=Web
